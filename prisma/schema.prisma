// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppPlan {
  ATS
  HRMS
  CRM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SystemRoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECRUITER
  EMPLOYEE
  CUSTOM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  roles         Role[]
  subscriptions Subscription[]
  jobs          Job[]

  @@index([slug])
}

model Role {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           SystemRoleType @default(CUSTOM)
  permissions    String[]       @default([])
  isSystem       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id               String    @id @default(uuid())
  organizationId   String
  roleId           String
  email            String
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  jobs         Job[]

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@index([email])
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  activePlans          AppPlan[]          @default([])
  status               SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  trialEndsAt          DateTime?
  maxUsers             Int                @default(10)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Job {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  department     String?
  location       String?
  employmentType EmploymentType  @default(FULL_TIME)
  status         JobStatus       @default(DRAFT)
  salaryMin      Decimal?
  salaryMax      Decimal?
  salaryCurrency String?         @default("INR")
  salaryVisible  Boolean         @default(true)
  experienceMin  Int?
  experienceMax  Int?
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  pipelineStages PipelineStage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model PipelineStage {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String // "Applied", "Screening", "Interview", "Offer", "Hired", "Rejected"
  order     Int // for sorting stages left-to-right
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, order])
  @@index([jobId])
}
